{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowFullAccessToOwnFolder",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": "arn:aws:s3:::smriti-aws-access-control/smriti/*"
        },
        {
            "Sid": "AllowReadAccessToPalakFolder",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject"
            ],
            "Resource": "arn:aws:s3:::smriti-aws-access-control/palak/*"
        },
        {
            "Sid": "AllowBucketListing",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket"
            ],
            "Resource": "arn:aws:s3:::smriti-aws-access-control"
        }
    ]
}